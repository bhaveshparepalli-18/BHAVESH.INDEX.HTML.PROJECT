# -------------------------------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.swn
.sublime-workspace
.sublime-project

# VS Code (ignore workspace state, keep recommendations if needed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# -------------------------------------------------------------------
# 7. LOCAL DATABASE & STORAGE DUMPS
# -------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.dump
dump.rdb

