# ===================================================================
# GITIGNORE - AMAZON SHOPPING MALL PROJECT
# Excludes sensitive secrets, dependencies, system files & builds
# ===================================================================

# -------------------------------------------------------------------
# 1. ENVIRONMENT VARIABLES & SECRETS (CRITICAL: NEVER PUSH TO GITHUB)
# -------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
*.env.*

# Backend specific environment files
backend/.env
backend/.env.local
backend/.env.*

# API Keys, Private Certificates & Secret Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_rsa.pub
credentials.json
client_secret*.json
serviceAccountKey.json

# -------------------------------------------------------------------
# 2. DEPENDENCY DIRECTORIES
# -------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.js

# -------------------------------------------------------------------
# 3. BUILD ARTIFACTS & CACHES
# -------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
*.tsbuildinfo

# -------------------------------------------------------------------
# 4. LOGS & DEBUGGING
# -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -------------------------------------------------------------------
# 5. OPERATING SYSTEM ARTIFACTS
# -------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# Linux
*~
.directory

# -------------------------------------------------------------------
